# Secrets only -- copy to .env and fill in. Never commit .env.

# Agent model API (DeepSeek is the default provider)
DEEPSEEK_API_KEY=

# Optional OpenAI-compatible provider
# OPENAI_API_KEY=

# Optional vision provider (OpenAI-compatible, e.g. Qwen-VL via DashScope)
# DASHSCOPE_API_KEY=

# Xiaohongshu cookie (document.cookie value) used by the crawl tool
# XHS_COOKIE=
