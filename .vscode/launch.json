{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Celebrity 启动",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "console": "integratedTerminal",
      "justMyCode": false,
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    },
    {
      "name": "Celebrity 横幅预览",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/main.py",
      "args": ["--banner-only"],
      "console": "integratedTerminal",
      "env": {
        "PYTHONIOENCODING": "utf-8"
      }
    }
  ]
}